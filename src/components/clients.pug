include ../../data/stats

section.clients.section
  .container
    +section-header(
      'Clients & kind words',
      'Some of the teams that trusted us with their brands.'
    )
    ul.client-logos
      each client in clients
        li.client-logo(class=`logo-${client.slug}`) #{client.name}

    blockquote.testimonial
      span.quote-mark(aria-hidden='true') “
      p.testimonial-text #{testimonial.text}
      footer.testimonial-author
        .author-info
          .author-avatar(aria-hidden='true') #{testimonial.initials}
          .author-details
            p.author-name #{testimonial.author}
            p.author-role #{testimonial.role}
        .slider-dots(aria-hidden='true')
          each _, i in [0, 1, 2]
            span.dot(class={ active: i === 0 })