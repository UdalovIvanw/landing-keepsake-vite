include ../../data/journal

section#journal.journal.section
  .container
    +section-header(
      'From the journal',
      'Notes on process, case studies and things that inspire us.',
      'journal-title-box'
    )
    .journal-grid
      each post in journalPosts
        article.journal-card
          .journal-thumb
            +picture(
              post.image,
              post.alt,
              150,
              150,
              '(min-width: 768px) 150px, 96px'
            )
          .journal-content
            p.journal-meta #{post.date} / #{post.category}
            h3.journal-title #{post.title}
            p.journal-excerpt #{post.excerpt}
            a.read-more(href=post.href)
              | Read more
              +icon('arrow-up')