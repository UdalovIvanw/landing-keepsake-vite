mixin picture(name, alt, width, height, sizes, className = '', isFirst = false)
  - var loadingMode = false
  unless isFirst
    - loadingMode = 'lazy'

  picture
    source(
      type='image/avif'
      srcset=`../assets/images/${name}-400.avif 400w, ../assets/images/${name}-800.avif 800w`
      sizes=sizes
    )
    source(
      type='image/webp'
      srcset=`../assets/images/${name}-400.webp 400w, ../assets/images/${name}-800.webp 800w`
      sizes=sizes
    )
    img(
      class=className
      src=`../assets/images/${name}-800.jpg`
      alt=alt
      width=width
      height=height
      loading=loadingMode
      decoding='async'
      fetchpriority=isFirst ? 'high' : false
    )